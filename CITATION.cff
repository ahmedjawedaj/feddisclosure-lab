    alias: ahmedjawedaj
version: 0.15.0
date-released: 2026-11-23
license: Apache-2.0
repository-code: "https://github.com/ahmedjawedaj/feddisclosure-lab"
keywords:
  - federated learning
  - differential privacy
  - secure aggregation
  - membership inference
  - gradient inversion
  - reproducible research
